---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { SITE_URL } from '../lib/content';
---
<Layout
  title="Privacy Policy"
  description="Privacy policy for jvar.nl — how Google Analytics data is collected and used, your GDPR rights, and third-party services."
  noindex
>
  <Fragment slot="head">
    <link rel="canonical" href={`${SITE_URL}/privacy-policy/`} />
  </Fragment>

  <Hero
    slot="hero"
    variant="page"
    title="Privacy Policy"
    lede="This policy explains what data is collected when you visit jvar.nl and how it is used."
  >
    <span slot="chips" class="badge teal">Legal</span>
  </Hero>

  <section class="wrap section pb-16">
    <article class="post-body policy">
      <section class="block">
        <h2>Who we are</h2>
        <p>
          This website is operated by Jasper van Rijbroek (jvar.nl). If you have any questions about this policy,
          you can contact me at <a href="mailto:hello@jvar.nl">hello@jvar.nl</a>.
        </p>
      </section>

      <section class="block">
        <h2>Analytics (Google Analytics 4)</h2>
        <p>
          This site uses Google Analytics 4 to understand how visitors use it. GA4 collects anonymised data about
          page views, session duration, and general traffic sources. IP addresses are anonymised before storage. No
          personally identifiable information is collected.
        </p>
        <p>
          The legal basis for this processing is <strong>legitimate interest</strong> (GDPR Art. 6(1)(f)) —
          understanding site usage to improve content quality. The <code>respectDNT</code> flag is enabled, so
          visitors who have set the Do Not Track browser preference are not tracked.
        </p>
        <p>
          You can opt out of Google Analytics tracking at any time using the{' '}
          <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noreferrer">
            Google Analytics opt-out browser add-on
          </a>.
        </p>
      </section>

      <section class="block">
        <h2>Cookies</h2>
        <p>
          Google Analytics sets cookies to distinguish unique visitors and sessions. These are first-party cookies
          stored under the <code>jvar.nl</code> domain. No third-party advertising cookies are used.
        </p>
      </section>

      <section class="block">
        <h2>Third-party services</h2>
        <p>This site uses the following third-party services:</p>
        <ul>
          <li>
            <strong>Google Fonts</strong> — fonts are loaded from Google's servers. Google may log your IP address
            when fonts are fetched. See{' '}
            <a href="https://policies.google.com/privacy" target="_blank" rel="noreferrer">Google's Privacy Policy</a>.
          </li>
          <li>
            <strong>Cloudflare</strong> — CDN and DDoS protection. Cloudflare may process request metadata. See{' '}
            <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noreferrer">Cloudflare's Privacy Policy</a>.
          </li>
        </ul>
      </section>

      <section class="block">
        <h2>Your rights (GDPR)</h2>
        <p>
          If you are located in the EU/EEA you have the right to access, correct, or erase any personal data we hold
          about you, to object to or restrict processing, and to lodge a complaint with your local data protection
          authority. Since we collect only anonymised analytics data, we cannot link it to a specific individual.
        </p>
        <p>
          For any privacy-related requests, contact <a href="mailto:hello@jvar.nl">hello@jvar.nl</a>.
        </p>
      </section>

      <section>
        <h2>Changes to this policy</h2>
        <p>This policy may be updated occasionally. Changes will be published on this page with the updated date below.</p>
        <p class="updated">Last updated: June 2026</p>
      </section>
    </article>
  </section>
</Layout>

<style>
  .pb-16 {
    padding-bottom: 16px;
  }

  .badge.teal {
    background: var(--accent-2);
  }

  .policy {
    max-width: 720px;
  }

  .block {
    margin-bottom: 48px;
  }

  .policy h2 {
    margin: 0 0 16px;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .updated {
    font-size: 14px;
    color: var(--muted);
  }
</style>
