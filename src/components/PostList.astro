---
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';
import TopicFilters from './TopicFilters.astro';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';
import { getPostHeroImage } from '../lib/images';
import { blogListSchema } from '../lib/seo';
import { type Post, paginate, pageCount, absoluteUrl } from '../lib/content';

/**
 * Paginated listing screen: a topic's posts, or the whole archive when no
 * topic is given. Page 1 lives at `base`, later pages at `${base}page/N/`.
 */
interface Props {
  posts: Post[];
  currentPage: number;
  base: string;
  title: string;
  lede?: string | null;
  topicSlug?: string;
  image?: ImageMetadata;
  description?: string;
}

const { posts, currentPage, base, title, lede, topicSlug, image, description } = Astro.props;

const numPages = pageCount(posts.length);
const pagePosts = paginate(posts, currentPage);

const chipLabel = topicSlug
  ? `Topic${posts.length ? ` — ${posts.length} posts` : ''}`
  : `Page ${currentPage} of ${numPages}`;

const trail: Crumb[] = [
  { label: 'Home', href: '/' },
  topicSlug
    ? { label: title, href: base }
    : { label: 'All posts', href: `${base}page/${currentPage}/` },
];

const pageTitle = currentPage > 1 ? `${title} — page ${currentPage}` : title;
const pageUrl = (page: number) => absoluteUrl(page === 1 ? base : `${base}page/${page}/`);

/* Topic landings describe themselves as a Blog; the archive's page 1 is the
 * home page, which carries its own schema. */
const schema =
  topicSlug && currentPage === 1
    ? [await blogListSchema(pagePosts, { name: title, url: absoluteUrl(base), description: description ?? '' })]
    : [];
---
<Layout
  title={pageTitle}
  description={description}
  canonical={base}
  noindex={currentPage > 1}
  image={image ?? (pagePosts[0] && getPostHeroImage(pagePosts[0].data.slug))}
  imageAlt={title}
  schema={schema}
>
  <Fragment slot="head">
    {currentPage > 1 && <link rel="prev" href={pageUrl(currentPage - 1)} />}
    {currentPage < numPages && <link rel="next" href={pageUrl(currentPage + 1)} />}
  </Fragment>

  <Hero slot="hero" variant="page" title={title} lede={lede} image={image} imageAlt={title}>
    <Breadcrumbs slot="breadcrumbs" trail={trail} />
    <span slot="chips" class="badge">{chipLabel}</span>
  </Hero>

  <section class="wrap section">
    <TopicFilters activeTopic={topicSlug} />

    <div class="grid">
      {pagePosts.map((post) => <PostCard post={post} variant="grid" />)}
    </div>

    {numPages > 0 && <Pagination currentPage={currentPage} numPages={numPages} base={base} />}
  </section>
</Layout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 36px 28px;
  }
</style>
