---
import { Image } from 'astro-lqip/components';
import type { ImageMetadata } from 'astro';
import fallbackImage from '../assets/pexels-oleksandr-p-13593499.jpg';

/**
 * Full-bleed hero used by every screen.
 *
 * `home`    — tall editorial opener with kicker, headline, lede and CTAs.
 * `article` — post cover with chips above the title.
 * `page`    — short dark band for topic, contact and the static pages.
 *
 * When no image is supplied it falls back to the local cover shot, which is
 * also what the site used before the redesign.
 *
 * Slots: `breadcrumbs`, `chips`, `actions`.
 */
interface Props {
  variant?: 'home' | 'article' | 'page';
  eyebrow?: string;
  title: string;
  lede?: string | null;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { variant = 'page', eyebrow, title, lede, image, imageAlt = '' } = Astro.props;

const heroImage = image ?? fallbackImage;
const isHome = variant === 'home';
const isArticle = variant === 'article';
---
<section class:list={['hero', 'dark-surface', variant]}>
  <Image
    src={heroImage}
    alt={imageAlt}
    width={1920}
    height={815}
    class="bg"
    priority
  />
  <div class="scrim" aria-hidden="true"></div>

  <div class:list={['content', isArticle ? 'narrow' : 'wrap']}>
    <slot name="breadcrumbs" />

    {eyebrow && <div class="kicker">{eyebrow}</div>}

    {Astro.slots.has('chips') && (
      <div class="chips">
        <slot name="chips" />
      </div>
    )}

    <h1>{title}</h1>

    {lede && <p class="lede">{lede}</p>}

    {Astro.slots.has('actions') && (
      <div class="actions">
        <slot name="actions" />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--off-white);
  }

  .hero.home {
    height: min(86vh, 760px);
    min-height: 520px;
  }

  .hero.article {
    height: min(70vh, 620px);
    min-height: 420px;
  }

  .hero :global([data-astro-lqip]) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }

  .hero .bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero.home .bg {
    opacity: 0.88;
  }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: linear-gradient(180deg, rgba(20, 14, 10, 0.58), rgba(20, 14, 10, 0.86));
  }

  .hero.home .scrim {
    background-image: linear-gradient(
      180deg,
      rgba(20, 14, 10, 0.45) 0%,
      rgba(20, 14, 10, 0.42) 40%,
      rgba(20, 14, 10, 0.84) 100%
    );
  }

  .hero.article .scrim {
    background-image: linear-gradient(180deg, rgba(20, 14, 10, 0.2), rgba(20, 14, 10, 0.8));
  }

  .content {
    position: relative;
    z-index: 2;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: flex-end;
    gap: 18px;
    padding-top: clamp(64px, 9vw, 110px);
    padding-bottom: clamp(40px, 6vw, 64px);
  }

  .content.narrow {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding-left: var(--page-pad);
    padding-right: var(--page-pad);
  }

  .hero.home .content,
  .hero.article .content {
    padding-top: clamp(20px, 4vw, 32px);
    padding-bottom: clamp(20px, 4vw, 32px);
  }

  .hero.home .content {
    gap: 22px;
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tan);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  h1 {
    margin: 0;
    color: var(--off-white);
    text-wrap: balance;
    font-size: clamp(40px, 6vw, 80px);
    line-height: 0.96;
    letter-spacing: -0.04em;
  }

  .hero.home h1 {
    max-width: 16ch;
    font-size: clamp(46px, 7.4vw, 104px);
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .hero.article h1 {
    font-size: clamp(38px, 5.4vw, 68px);
    line-height: 0.98;
  }

  .lede {
    margin: 0;
    max-width: 52ch;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(253, 250, 245, 0.9);
  }

  .hero.home .lede {
    max-width: 56ch;
    color: var(--off-white);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 6px;
  }
</style>
