---
/**
 * Section title with a hairline rule and an optional right-hand mono note,
 * which becomes a link when `noteHref` is given.
 *
 * `rule="top"` moves the hairline above the heading (used for "Read next").
 */
interface Props {
  title: string;
  id?: string;
  note?: string;
  noteHref?: string;
  rule?: 'bottom' | 'top';
  /** Space below the rule, in px. */
  mb?: number;
}

const { title, id, note, noteHref, rule = 'bottom', mb = 0 } = Astro.props;
---
<div class:list={['section-heading', `rule-${rule}`]} style={`margin-bottom:${mb}px`}>
  <h2 id={id}>{title}</h2>
  {note && !noteHref && <div class="note">{note}</div>}
  {note && noteHref && <a href={noteHref} class="note link transition-motion">{note}</a>}
</div>

<style>
  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }

  .rule-bottom {
    border-bottom: 1px solid var(--border);
    padding-bottom: 16px;
  }

  .rule-top {
    border-top: 1px solid var(--border);
    padding-top: 28px;
  }

  h2 {
    font-size: clamp(30px, 4vw, 40px);
    letter-spacing: -0.03em;
  }

  .note {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .note.link {
    color: var(--rust);
  }

  .note.link:hover {
    color: var(--ink);
  }
</style>
