---
import { Image } from 'astro-lqip/components';
import jasper from '../assets/jasper.jpeg';
import { AUTHOR_NAME } from '../lib/content';

const BIO =
  "I'm a PHP and NodeJS developer who was born in Amsterdam, NL but now lives in beautiful Valencia, Spain. I work remotely full-time and enjoy blogging about everything related to this wonderful country. Let me know if you have any questions about Spain — I'd be more than happy to help!";

/**
 * Author block. `full` is the homepage sign-off, `byline` the compact row that
 * closes an article.
 */
interface Props {
  variant?: 'full' | 'byline';
}

const { variant = 'full' } = Astro.props;
---
{variant === 'byline' ? (
  <div class="bio byline">
    <Image src={jasper} alt={AUTHOR_NAME} width={112} height={112} class="avatar" />
    <div>
      <div class="name">{AUTHOR_NAME}</div>
      <div class="tagline">Writing from Valencia since 2023. Questions about Spain? Just ask.</div>
    </div>
  </div>
) : (
  <div class="bio full">
    <Image src={jasper} alt={AUTHOR_NAME} width={176} height={176} class="avatar" />
    <div>
      <h3>{AUTHOR_NAME}</h3>
      <p>{BIO}</p>
    </div>
  </div>
)}

<style>
  .bio :global([data-astro-lqip]) {
    flex-shrink: 0;
  }

  .avatar {
    display: block;
    border-radius: 999px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .full {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 28px;
    padding-top: 36px;
    border-top: 1px solid var(--border);
  }

  .full .avatar,
  .full :global([data-astro-lqip]) {
    width: 88px;
    height: 88px;
  }

  .full h3 {
    margin: 0 0 10px;
    font-size: 28px;
  }

  .full p {
    margin: 0;
    max-width: 66ch;
    font-size: 16px;
    line-height: 1.65;
    color: var(--muted);
  }

  .byline {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 20px;
    margin-bottom: 72px;
    padding: 32px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .byline .avatar,
  .byline :global([data-astro-lqip]) {
    width: 56px;
    height: 56px;
  }

  .byline .name {
    font-size: 16px;
    font-weight: 600;
  }

  .byline .tagline {
    font-size: 14px;
    color: var(--muted);
  }
</style>
